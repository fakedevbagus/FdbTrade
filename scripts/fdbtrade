#!/usr/bin/env python3
"""FdbTrade operator CLI (M44).

Stdlib-only, deterministic. Loopback 127.0.0.1.
LIVE_EXECUTION_ENABLED=false, PROVIDER_ORDER_TRANSPORT_ENABLED=false.
"""

import argparse, contextlib, fcntl, json, os, pathlib, shutil, signal, socket, subprocess, sys, time, urllib.error, urllib.request
from datetime import datetime, timezone

REPO_ROOT = pathlib.Path(__file__).resolve().parent.parent
VENV_DIR = REPO_ROOT / ".venv"
RUN_DIR = REPO_ROOT / ".fdbtrade" / "run"
STATE_FILE = RUN_DIR / "lifecycle.json"
TOOLCHAIN = REPO_ROOT / "scripts" / "rebuild_toolchain.py"
PROBE_TIMEOUT_SECONDS = 10


def utc_now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(msg):
    """Human-readable diagnostics go to stderr so stdout stays machine-parseable."""
    print(f"[{utc_now_iso()}] {msg}", file=sys.stderr)


def _version(command):
    """Run a bounded version probe and return its first output line."""
    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=True,
        timeout=PROBE_TIMEOUT_SECONDS,
    )
    return result.stdout.strip().splitlines()[0]


def preflight(as_json=False):
    errors = []
    warnings = []
    checks = {}

    # Python
    py_version = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    checks["python"] = py_version
    log(f"Python: {py_version}")

    # Node
    try:
        checks["node"] = _version(["node", "--version"])
        log(f"Node: {checks['node']}")
    except Exception as e:
        errors.append(f"Node not found: {e}")

    # npm
    try:
        checks["npm"] = _version(["npm", "--version"])
        log(f"npm: {checks['npm']}")
    except Exception as e:
        warnings.append(f"npm not found: {e}")

    # pnpm — resolve the packageManager-pinned version through the same
    # isolated Corepack cache as every R0.3 install. This never depends on or
    # writes to the operator's home directory.
    try:
        result = subprocess.run(
            [sys.executable, str(TOOLCHAIN), "--json", "manager-version"],
            capture_output=True,
            text=True,
            check=False,
            timeout=70,
        )
        report = json.loads(result.stdout)
        manager_result = report["results"][0]
        if result.returncode != 0 or manager_result["status"] != "pass":
            raise RuntimeError(manager_result.get("firstActionableFailure") or "manager probe failed")
        checks["pnpm"] = manager_result["stdoutTail"].strip().splitlines()[0]
        log(f"pnpm: {checks['pnpm']} (isolated Corepack)")
    except Exception as e:
        warnings.append(f"pnpm not found: {e}")

    # Make
    try:
        checks["make"] = _version(["make", "--version"])
        log(f"Make: {checks['make']}")
    except Exception as e:
        errors.append(f"Make not found: {e}")

    # Bash
    try:
        checks["bash"] = _version(["bash", "--version"])
        log(f"Bash: {checks['bash']}")
    except Exception as e:
        errors.append(f"Bash not found: {e}")

    # SQLite — report both the CLI binary and the Python stdlib driver, because
    # the private beta Python side is stdlib-driven and the host binary may be
    # absent. Availability is reported honestly; it is never assumed.
    try:
        checks["sqlite3"] = _version(["sqlite3", "--version"])
        log(f"SQLite: {checks['sqlite3']}")
    except Exception:
        checks["sqlite3"] = "not found"
        warnings.append("sqlite3 CLI binary not found (Python stdlib sqlite3 module is used instead)")

    try:
        import sqlite3 as _stdlib_sqlite3
        checks["python_sqlite"] = _stdlib_sqlite3.sqlite_version
        log(f"Python sqlite3 module: {_stdlib_sqlite3.sqlite_version}")
    except Exception as e:
        checks["python_sqlite"] = "unavailable"
        errors.append(f"Python sqlite3 module unavailable: {e}")

    # Disk
    total, used, free = shutil.disk_usage(REPO_ROOT)
    free_gb = free // (2**30)
    checks["disk"] = f"{free_gb}GB free"
    log(f"Disk: {free_gb}GB free")
    if free_gb < 5:
        warnings.append(f"Low disk: {free_gb}GB free (>5GB recommended)")

    # Permissions
    if os.access(REPO_ROOT, os.W_OK):
        checks["permissions"] = "writable"
        log("Permissions: writable")
    else:
        errors.append("Repo not writable")

    # Ports (loopback only — the private beta never binds a public interface)
    port_state = {}
    socket_probe_warning = False
    for port in (3000, 3100):
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
                sock.settimeout(1)
                result = sock.connect_ex(("127.0.0.1", port))
            if result == 0:
                port_state[str(port)] = "in_use"
                warnings.append(f"Port {port} in use on 127.0.0.1")
            else:
                port_state[str(port)] = "available"
        except OSError as error:
            port_state[str(port)] = "probe_unavailable"
            if not socket_probe_warning:
                warnings.append(
                    f"Loopback socket probe unavailable in this environment: "
                    f"{error.__class__.__name__}: {error}"
                )
                socket_probe_warning = True
    checks["ports"] = port_state

    log("Ports checked on loopback: 3000, 3100")
    # Guarantee the full documented preflight surface is always reported, even
    # when a tool is missing, so downstream gates and tests see stable keys.
    for key in ("python", "node", "npm", "pnpm", "make", "bash", "sqlite3",
                "python_sqlite", "disk", "permissions", "ports"):
        checks.setdefault(key, "unavailable")

    payload = {
        "command": "preflight",
        "checkedAt": utc_now_iso(),
        "status": "fail" if errors else ("warn" if warnings else "pass"),
        "errors": errors,
        "warnings": warnings,
        "checks": checks,
        "safety": {
            "liveExecutionEnabled": False,
            "providerOrderTransportEnabled": False,
            "loopbackOnly": True,
        },
    }

    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 1 if errors else 0

    print()
    if errors:
        print("ERRORS:")
        for e in errors:
            print(f"  ERROR: {e}")
    if warnings:
        print("WARNINGS:")
        for w in warnings:
            print(f"  WARN: {w}")
    if not errors and not warnings:
        print("All preflight checks passed")
    print()
    print(json.dumps(checks, indent=2))
    return 1 if errors else 0


def has_installable_requirements(req_file):
    """True when a requirements file declares at least one installable line.

    An installable-free file is valid policy here: the Python side is
    stdlib-only, and `pip install -r` would otherwise abort with
    "You must give at least one requirement to install".
    """
    if not req_file.exists():
        return False
    for line in req_file.read_text(encoding="utf-8").splitlines():
        if line.split("#", 1)[0].strip():
            return True
    return False


def init(dry_run=False):
    log("Initializing..." + (" (dry run)" if dry_run else ""))
    if not VENV_DIR.exists():
        if dry_run:
            log(f"PLAN: create venv at {VENV_DIR}")
        else:
            log(f"Creating venv at {VENV_DIR}...")
            try:
                subprocess.run([sys.executable, "-m", "venv", str(VENV_DIR)], check=True, capture_output=True)
                log("Venv created")
            except Exception as e:
                log(f"ERROR: venv create failed: {e}")
                return 1
    else:
        log(f"Venv exists at {VENV_DIR}")

    req_file = REPO_ROOT / "requirements.txt"
    if has_installable_requirements(req_file):
        if dry_run:
            log("PLAN: pip install -r requirements.txt (locked pins only)")
        else:
            log("Installing declared Python deps...")
            pip = str(VENV_DIR / "bin" / "pip")
            try:
                subprocess.run([pip, "install", "-r", str(req_file)], check=True)
                log("Python deps installed")
            except Exception as e:
                log(f"ERROR: Python deps failed: {e}")
                return 1
    else:
        log("No installable Python requirements (quant/tests/scripts are stdlib-only)")

    if dry_run:
        log("PLAN: pnpm install --frozen-lockfile")
        log("Dry run complete: no changes were made")
        return 0

    log("Installing Node deps through the bounded R0.3 toolchain...")
    try:
        subprocess.run([sys.executable, str(TOOLCHAIN), "install"], check=True, cwd=str(REPO_ROOT))
        log("Node deps installed")
    except Exception as e:
        log(f"ERROR: Node deps failed: {e}")
        return 1

    log("Initialization complete")
    return 0


def _data_root():
    configured = os.environ.get("FDB_DATA_ROOT", "").strip()
    if configured:
        path = pathlib.Path(configured)
        if not path.is_absolute():
            raise ValueError("FDB_DATA_ROOT must be an absolute path")
        return path.resolve()
    return REPO_ROOT / ".fdbtrade"


def _runtime_paths():
    run_dir = _data_root() / "run"
    return run_dir, run_dir / "lifecycle.json", run_dir / "operator.lock"


@contextlib.contextmanager
def _lifecycle_guard():
    run_dir, _, lock_path = _runtime_paths()
    run_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(run_dir, 0o700)
    with lock_path.open("a+", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        yield


def _process_start_token(pid):
    try:
        # Linux /proc stat field 22 is the process start tick. Parenthesized
        # command names may contain spaces, so split only after the final ')'.
        fields = pathlib.Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()
        if fields[0] == "Z":
            return None
        return fields[19]
    except (FileNotFoundError, PermissionError, IndexError, OSError):
        return None


def _record_process(proc, role, port):
    return {
        "role": role,
        "pid": proc.pid,
        "pgid": os.getpgid(proc.pid),
        "startToken": _process_start_token(proc.pid),
        "port": port,
    }


def _write_lifecycle_state(payload):
    run_dir, state_file, _ = _runtime_paths()
    run_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = state_file.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, state_file)


def _read_lifecycle_state():
    _, state_file, _ = _runtime_paths()
    if not state_file.exists():
        return None
    try:
        payload = json.loads(state_file.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"invalid lifecycle state: {error}") from error
    if payload.get("schemaVersion") != 1 or not isinstance(payload.get("processes"), list):
        raise ValueError("invalid lifecycle state schema")
    return payload


def _record_is_live(record):
    pid = record.get("pid")
    token = record.get("startToken")
    return (
        isinstance(pid, int)
        and isinstance(token, str)
        and _process_start_token(pid) == token
    )


def _backend_probe():
    try:
        with urllib.request.urlopen("http://127.0.0.1:3100/api/health", timeout=2) as response:
            body = json.loads(response.read().decode("utf-8"))
            health = body.get("data", body)
            return {
                "reachable": response.status == 200,
                "ready": response.status == 200 and health.get("status") == "ok",
                "status": health.get("status", "unknown"),
                "checks": health.get("checks", {}),
                "runtime": health.get("runtime"),
            }
    except Exception as error:
        return {"reachable": False, "ready": False, "status": "unavailable", "error": str(error)}


def _frontend_probe():
    try:
        with urllib.request.urlopen("http://127.0.0.1:3000/login", timeout=2) as response:
            return {
                "reachable": response.status < 500,
                "ready": response.status < 500,
                "status": "ok" if response.status < 500 else "degraded",
            }
    except Exception as error:
        return {"reachable": False, "ready": False, "status": "unavailable", "error": str(error)}


def _terminate_records(records, timeout_seconds=10):
    live = [record for record in records if _record_is_live(record)]
    for record in reversed(live):
        try:
            os.killpg(record["pgid"], signal.SIGTERM)
            log(f"Sent SIGTERM to recorded {record['role']} process group {record['pgid']}")
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + timeout_seconds
    while live and time.monotonic() < deadline:
        live = [record for record in live if _record_is_live(record)]
        if live:
            time.sleep(0.1)
    for record in live:
        try:
            os.killpg(record["pgid"], signal.SIGKILL)
            log(f"Sent SIGKILL to unresponsive recorded {record['role']} process group {record['pgid']}")
        except ProcessLookupError:
            pass
    return len(live) == 0


def start():
    """Start frontend and backend as one bounded loopback-only lifecycle."""
    with _lifecycle_guard():
        log("Starting FdbTrade frontend and backend...")
        database_path = _data_root() / "fdbtrade.sqlite3"
        if not database_path.is_file():
            log(f"ERROR: SQLite is not initialized at {database_path}; run make db-migrate")
            return 1
        try:
            existing_state = _read_lifecycle_state()
        except ValueError as error:
            log(f"ERROR: {error}; refusing to overwrite unverifiable process ownership")
            return 1
        if existing_state and any(_record_is_live(item) for item in existing_state["processes"]):
            log("ERROR: a recorded FdbTrade lifecycle is already running; use 'fdbtrade status'")
            return 1
        occupied = {
            port: {"inUse": _port_is_in_use(port), "visiblePids": _pids_listening_on(port)}
            for port in (3000, 3100)
        }
        if any(item["inUse"] for item in occupied.values()):
            log(f"ERROR: required loopback ports are occupied by unmanaged processes: {occupied}")
            return 1

        run_dir, state_file, _ = _runtime_paths()
        processes = []
        log_handles = []
        env = os.environ.copy()
        env["FDB_DATA_ROOT"] = str(_data_root())
        commands = (
            ("backend", 3100, ["corepack", "pnpm", "--filter", "@fdbtrade/backend", "dev"]),
            ("frontend", 3000, ["corepack", "pnpm", "--filter", "@fdbtrade/frontend", "dev"]),
        )
        try:
            for role, port, command in commands:
                output = (run_dir / f"{role}.log").open("ab", buffering=0)
                log_handles.append(output)
                proc = subprocess.Popen(
                    command,
                    cwd=str(REPO_ROOT),
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
                processes.append(_record_process(proc, role, port))
                _write_lifecycle_state({
                    "schemaVersion": 1,
                    "phase": "starting",
                    "startedAtUtc": utc_now_iso(),
                    "loopbackOnly": True,
                    "processes": processes,
                })
            deadline = time.monotonic() + 60
            while time.monotonic() < deadline:
                if not all(_record_is_live(item) for item in processes):
                    break
                if _backend_probe()["ready"] and _frontend_probe()["ready"]:
                    _write_lifecycle_state({
                        "schemaVersion": 1,
                        "phase": "running",
                        "startedAtUtc": utc_now_iso(),
                        "loopbackOnly": True,
                        "processes": processes,
                    })
                    log("FdbTrade ready: frontend http://127.0.0.1:3000, backend http://127.0.0.1:3100")
                    return 0
                time.sleep(0.5)
            log("ERROR: local applications did not become truthfully ready within 60 seconds")
            _terminate_records(processes)
            state_file.unlink(missing_ok=True)
            return 1
        finally:
            for handle in log_handles:
                handle.close()


def _pids_listening_on(port):
    """PIDs listening on a loopback port, without broad process-name matching."""
    pids = []
    try:
        result = subprocess.run(["ss", "-tlnpH"], capture_output=True, text=True)
        if result.returncode == 0:
            for line in result.stdout.splitlines():
                if f":{port}" not in line:
                    continue
                for token in line.split():
                    if not token.startswith("users:"):
                        continue
                    for part in token.split(","):
                        if "pid=" in part:
                            value = part.split("pid=", 1)[1].split(",")[0]
                            if value.isdigit():
                                pids.append(int(value))
    except Exception:
        pass
    return sorted(set(pids))


def _port_is_in_use(port):
    """Truthful loopback reachability, including listeners whose PID is hidden."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            probe.settimeout(0.5)
            return probe.connect_ex(("127.0.0.1", port)) == 0
    except OSError:
        return True


def stop():
    """Stop only process groups proven by PID plus Linux process-start token."""
    with _lifecycle_guard():
        log("Stopping FdbTrade services...")
        _, state_file, _ = _runtime_paths()
        try:
            state = _read_lifecycle_state()
        except ValueError as error:
            log(f"ERROR: {error}; refusing broad process termination")
            return 1
        if state is None:
            occupied = {
                port: {"inUse": _port_is_in_use(port), "visiblePids": _pids_listening_on(port)}
                for port in (3000, 3100)
            }
            if any(item["inUse"] for item in occupied.values()):
                log(f"ERROR: unmanaged listeners remain; refusing to stop them: {occupied}")
                return 1
            log("No recorded FdbTrade lifecycle found")
            return 0
        records = state["processes"]
        if not _terminate_records(records):
            log("ERROR: one or more recorded processes could not be stopped")
            return 1
        state_file.unlink(missing_ok=True)
        log("FdbTrade frontend and backend stopped")
        return 0


def status(as_json=False):
    """Observe recorded ownership, both HTTP surfaces, and SQLite-backed health."""
    try:
        state = _read_lifecycle_state()
        state_error = None
    except ValueError as error:
        state = None
        state_error = str(error)
    processes = [] if state is None else [
        {**record, "ownedAndLive": _record_is_live(record)} for record in state["processes"]
    ]
    backend = _backend_probe()
    frontend = _frontend_probe()
    database_path = _data_root() / "fdbtrade.sqlite3"
    payload = {
        "command": "status",
        "status": (
            "running"
            if state_error is None
            and len(processes) == 2
            and all(item["ownedAndLive"] for item in processes)
            and backend["ready"]
            and frontend["ready"]
            else "stopped"
            if not processes and not backend["reachable"] and not frontend["reachable"]
            else "degraded"
        ),
        "loopbackOnly": True,
        "frontend": frontend,
        "backend": backend,
        "database": {
            "authority": "sqlite",
            "path": str(database_path),
            "initialized": database_path.is_file(),
        },
        "operatorState": {
            "authoritative": False,
            "error": state_error,
            "phase": state.get("phase") if state else None,
            "processes": processes,
        },
        "safety": {
            "liveExecutionEnabled": False,
            "providerOrderTransportEnabled": False,
        },
    }
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
        return 0
    print("\n=== FdbTrade Status ===\n")
    print(f"Lifecycle: {payload['status']}")
    print(f"Frontend  http://127.0.0.1:3000  {frontend['status']}")
    print(f"Backend   http://127.0.0.1:3100  {backend['status']}")
    print(f"Database  SQLite {database_path}  {'initialized' if database_path.is_file() else 'not initialized'}")
    if backend.get("runtime") is not None:
        print(f"Runtime   {json.dumps(backend['runtime'], sort_keys=True)}")
    if state_error:
        print(f"Operator state error: {state_error}")
    for process in processes:
        print(f"Recorded {process['role']}: PID {process['pid']} live={process['ownedAndLive']}")
    print("\nLIVE_EXECUTION_ENABLED=false")
    print("PROVIDER_ORDER_TRANSPORT_ENABLED=false\n")
    return 0


def check():
    """Run make check gates."""
    log("Running make check...")
    result = subprocess.run(["make", "check"], cwd=str(REPO_ROOT))
    return result.returncode


def recover():
    """Recovery guidance for common failures."""
    print("""
=== FdbTrade Recovery Guide ===

1. Port conflict (3000/3100 in use):
   fdbtrade status --json
   ss -tlnp | grep -E ':3000|:3100'
   Stop only when the recorded PID and process-start token prove ownership.

2. Database not initialized:
   make db-migrate
   make db-status

3. .env missing or corrupt:
   cp infra/.env.example .env
   make db-migrate

4. .venv missing or corrupt:
   rm -rf .venv
   fdbtrade init

5. Node modules missing:
   rm -rf node_modules
   pnpm install --frozen-lockfile

6. Git working tree dirty:
   git status
   git stash

7. Durable-state recovery:
   Stop both local applications and inspect RECOVERY.md. R0.5 intentionally has no
   approved destructive reset or SQLite restore command.

Documentation: See RECOVERY.md for details.
""")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="fdbtrade", description="FdbTrade operator CLI (M44)")
    sub = parser.add_subparsers(dest="cmd", help="commands")
    p_preflight = sub.add_parser("preflight", help="check dependencies and environment")
    p_preflight.add_argument("--json", action="store_true", help="emit machine-readable JSON only")
    p_init = sub.add_parser("init", help="create venv and install locked dependencies")
    p_init.add_argument("--dry-run", action="store_true", help="validate and print the plan only")
    sub.add_parser("start", help="start frontend and backend on loopback")
    sub.add_parser("stop", help="stop the recorded local lifecycle")
    p_status = sub.add_parser("status", help="show truthful local lifecycle health")
    p_status.add_argument("--json", action="store_true", help="emit machine-readable JSON only")
    sub.add_parser("check", help="run make check")
    sub.add_parser("recover", help="show recovery guidance")
    args = parser.parse_args()

    if not args.cmd:
        parser.print_help()
        return 0

    if args.cmd == "preflight":
        return preflight(as_json=args.json)
    if args.cmd == "init":
        return init(dry_run=args.dry_run)
    if args.cmd == "status":
        return status(as_json=args.json)

    handlers = {
        "start": start,
        "stop": stop,
        "check": check,
        "recover": recover,
    }
    return handlers.get(args.cmd, lambda: 2)()


if __name__ == "__main__":
    sys.exit(main())
