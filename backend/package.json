{
  "name": "@fdbtrade/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FdbTrade BFF/API — Next.js typed API foundation (P01-02): validation, structured errors, request IDs, health endpoint.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node src/db/migrate.mjs migrate",
    "db:rollback": "node src/db/migrate.mjs rollback",
    "db:status": "node src/db/migrate.mjs status",
    "db:provision-user": "node src/auth/provision.mjs"
  },
  "dependencies": {
    "@fdbtrade/contracts": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
