# FdbTrade configuration template (P00-03).
# Copy to a local, git-ignored `.env` (e.g. `cp infra/.env.example .env`) and fill in.
# Real secrets MUST stay in the local `.env` only; never commit values here.
# All internal timestamps are UTC. `FDB_APP_ENV` is always required.

# --- app ------------------------------------------------------------------ #
# Explicit environment: development | testing | staging | production
FDB_APP_ENV=development
FDB_APP_NAME=fdbtrade
FDB_APP_LOG_LEVEL=INFO
FDB_APP_TIMEZONE=UTC
FDB_APP_API_HOST=0.0.0.0
FDB_APP_API_PORT=8000

# --- database (PostgreSQL 16 via Docker) ---------------------------------- #
FDB_DB_HOST=localhost
FDB_DB_PORT=5432
FDB_DB_NAME=fdbtrade
FDB_DB_USER=fdbtrade
# Required in staging/production; leave empty in development/testing.
FDB_DB_PASSWORD=
FDB_DB_POOL_SIZE=10
FDB_DB_SSL_MODE=disable

# --- cache (Redis 7 via Docker) ------------------------------------------- #
FDB_CACHE_HOST=localhost
FDB_CACHE_PORT=6379
FDB_CACHE_DB=0
# Required in staging/production; leave empty in development/testing.
FDB_CACHE_PASSWORD=
FDB_CACHE_TTL_SECONDS=300
FDB_CACHE_PREFIX=fdbtrade

# --- market data ---------------------------------------------------------- #
FDB_MD_PROVIDER=fixture
FDB_MD_BASE_URL=
# Required in staging/production; leave empty in development/testing.
FDB_MD_API_KEY=
FDB_MD_SYMBOLS=
FDB_MD_RATE_LIMIT_PER_MIN=60
FDB_MD_TIMEOUT_SECONDS=10

# --- notifications -------------------------------------------------------- #
FDB_NOTIF_PROVIDER=log
FDB_NOTIF_FROM_ADDRESS=
FDB_NOTIF_SMTP_HOST=
FDB_NOTIF_SMTP_PORT=587
FDB_NOTIF_SMTP_USER=
# Required in staging/production; leave empty in development/testing.
FDB_NOTIF_SMTP_PASSWORD=
FDB_NOTIF_WEBHOOK_URL=
# Required in staging/production; leave empty in development/testing.
FDB_NOTIF_WEBHOOK_TOKEN=

# --- broker (paper by default; live execution OFF unless enabled) --------- #
FDB_BROKER_ADAPTER=paper
FDB_BROKER_LIVE_ENABLED=false
FDB_BROKER_READ_ONLY=true
FDB_BROKER_ACCOUNT_ID=
FDB_BROKER_ENDPOINT=
# Required in staging/production; leave empty in development/testing.
FDB_BROKER_TOKEN=

# --- research -------------------------------------------------------------- #
FDB_RS_DATA_DIR=artifacts/data
FDB_RS_RESULTS_DIR=artifacts/results
FDB_RS_RANDOM_SEED=42
FDB_RS_JOB_TIMEOUT_SECONDS=3600