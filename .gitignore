# FdbTrade — root ignore rules (P00-02)

# Dependencies
node_modules/

# Build outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment and secrets — never commit real .env files
.env
.env.*
!.env.example

# Local durable state and historical datasets (operator-owned, never commit)
.fdbtrade/
backend/.fdbtrade/

# Logs, artifacts, scratch
/logs/
*.log
# Build scratch under artifacts/ stays ignored, but the M44 private-beta
# acceptance evidence is an authority file and MUST be committable.
# Note: `artifacts/*` (not `artifacts/`) is required so the negative pattern
# below can re-include the subdirectory.
artifacts/*
!artifacts/private-beta/
# Rebuild checkpoints are reviewable repository evidence, not runtime output.
!artifacts/rebuild/
.tmp/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
